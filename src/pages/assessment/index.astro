---
import Base from '../../layouts/Base.astro';
import { EDGES } from '../../data/program';
import { DIMENSIONS, QUESTIONS, ROLES, BANDS, MAX_PER_DIM } from '../../data/assessment';

/* One question at a time, following the Narrative Assessment on
   inspireyourbuyers.com: a count, a progress rule, the dimension being
   measured, the statement, and stacked answers that advance on click.

   Nine questions stacked on one page read as a form to fill in.
   Presented one at a time they read as a conversation, and each answer
   carries the sense of getting somewhere.

   TAKING IT SENDS NOTHING. No storage, no analytics call, no email gate.
   State lives in a closure and dies with the tab.

   ONE deliberate exception, at the end and only on request: the reader can
   type an address to have the result emailed to them. That posts to
   functions/api/results.js, which sends through Resend and stores nothing.
   The download button next to it involves no server at all.

   The privacy page describes both in these exact terms. If either changes,
   that page changes in the same commit. It already had to once. */

const title = 'The Enterprise Edge assessment: which of the nine is costing you?';
const description =
  'A nine-dimension diagnostic across the arc of an enterprise deal, from finding value to expanding the account. Nine questions, about three minutes. Instant radar, no sign-in.';
const canonical = 'https://getenterpriseedge.com/assessment/';
---
<Base title={title} description={description} canonical={canonical}>

  <section class="band band-ink hero band-measure">
    <div class="wrap">
      <p class="eyebrow">The Enterprise Edge assessment</p>
      <h1>Nine dimensions. One of them is costing you.</h1>
      <p class="lede">Nine questions, about three minutes. You get a shape rather than a score, and the shape shows you where in the arc of a deal your revenue is leaking.</p>
      <p class="fine">No sign-in, no storage, and no email required to see your result. The scoring runs in your browser and disappears when you close the tab. At the end you can download the chart, or have it emailed to you if you would rather. That part is entirely up to you.</p>
    </div>
  </section>

  <section class="band band-bone" id="quiz">
    <div class="wrap">
      <div class="qcard">
        <div class="qtop">
          <p class="qcount" id="qcount">&nbsp;</p>
          <button class="qclear" type="button" id="clear">Start over</button>
        </div>
        <div class="qtrack"><i id="qfill"></i></div>

        <div id="stage" aria-live="polite">
          <p class="qdim" id="qdim">&nbsp;</p>
          <h2 class="qtext" id="qtext">&nbsp;</h2>
          <ul class="qopts" id="qopts"></ul>
        </div>

        <div class="qfoot">
          <button class="qback" type="button" id="back">Back</button>
        </div>
      </div>

      <noscript>
        <p class="fine" style="margin-top:2rem">This assessment scores in your browser, so it needs JavaScript. The nine dimensions it measures are described on the three edge pages if you would rather read them.</p>
      </noscript>
    </div>
  </section>

  <section class="band band-ink" id="result" hidden>
    <div class="wrap">
      <p class="eyebrow">Your result</p>
      <h2 id="band-name">&nbsp;</h2>
      <p class="lede" id="band-copy">&nbsp;</p>

      <div class="result-grid">
        <div class="radar-wrap"><div id="radar"></div></div>
        <div class="result-read">
          <p class="eyebrow">Weakest</p>
          <h3 id="weak-dim">&nbsp;</h3>
          <p id="weak-copy">&nbsp;</p>
          <p><a class="more" id="edge-link" href="/">&nbsp;</a></p>

          <p class="eyebrow" style="margin-top:2rem">By edge</p>
          <div id="edge-scores"></div>
        </div>
      </div>

      <div class="keep">
        <p class="eyebrow">Keep this</p>
        <p class="keep-lede">Your result exists only in this tab. Take the image, or have it sent to you.</p>

        <div class="keep-row">
          <button class="btn" type="button" id="dl">Download the image</button>
          <span class="keep-or">or</span>
          <form class="mailform" id="mailform" novalidate>
            <label class="sr-only" for="mailto-addr">Your email address</label>
            <input id="mailto-addr" name="email" type="email" inputmode="email"
                   autocomplete="email" placeholder="you@company.com" required />
            {/* Bots fill every field they find. People never see this one. */}
            <input class="ee-hp" id="ee-hp" name="company" type="text" tabindex="-1"
                   autocomplete="off" aria-hidden="true" />
            <button class="btn btn-ghost" type="submit" id="send">Email it to me</button>
          </form>
        </div>

        {/* Said before the field, not after. Someone should know what happens
            to their address before they type it, not once it has gone. */}
        <p class="fine keep-note">Nothing has left this page so far. If you enter an address, this result goes to it from assessment@getenterpriseedge.com, and Bruce, Dean and Sandy see that you asked for it along with the nine scores and the role you picked. That is the whole of it. No list, no tracking pixel, and nobody else gets your address. The <a href="/privacy/">privacy page</a> spells it out.</p>
        <p class="keep-status" id="mailstatus" role="status" hidden></p>
      </div>

      <div class="cta-pair">
        <a class="btn" href="/#dates">See dates and cities</a>
        <button class="more" type="button" id="again">Take it again</button>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ DIMENSIONS, QUESTIONS, ROLES, BANDS, EDGES, MAX_PER_DIM }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var DIM = {};
      DIMENSIONS.forEach(function (d) { DIM[d.key] = d; });

      /* Step 0 is the role. It is a question like any other so that the count,
         the progress rule and Back all behave the same way throughout. */
      /* Every question carries its own four answers now, so a step is just a
         label, a prompt and a list of [text, score] pairs. The role step
         scores nothing and is marked by having no key. */
      var STEPS = [{
        dim: 'Your role',
        text: 'Which of these is closest to your seat?',
        opts: ROLES.map(function (r) { return [r.l, 0]; }),
      }].concat(QUESTIONS.map(function (q) {
        return { dim: DIM[q.d].label, text: q.q, opts: q.a, key: q.d };
      }));

      var answers = new Array(STEPS.length).fill(null);
      var idx = 0;
      var started = false;   /* true once the reader has actually chosen something */

      function render() {
        var s = STEPS[idx];
        $('qcount').textContent = 'Question ' + (idx + 1) + ' of ' + STEPS.length;
        $('qdim').textContent = s.dim;
        $('qfill').style.width = (idx / STEPS.length) * 100 + '%';
        $('qtext').textContent = s.text;

        var ul = $('qopts');
        ul.innerHTML = '';
        s.opts.forEach(function (opt, i) {
          var label = opt[0];
          var li = document.createElement('li');
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'qopt';
          b.textContent = label;
          b.setAttribute('aria-pressed', answers[idx] === i ? 'true' : 'false');
          b.addEventListener('click', function () { choose(i); });
          li.appendChild(b);
          ul.appendChild(li);
        });

        $('back').style.visibility = idx === 0 ? 'hidden' : 'visible';

        /* Move focus to the first answer so the keyboard lands where the work
           is, but never on the very first paint: focusing scrolls, and on
           load that yanked the reader past the hero to a question they had
           not asked for yet. */
        if (started) {
          var first = ul.querySelector('.qopt');
          if (first) first.focus();
        }
      }

      function choose(i) {
        started = true;
        answers[idx] = i;
        if (idx < STEPS.length - 1) { idx++; render(); }
        else { finish(); }
      }

      $('back').addEventListener('click', function () {
        if (idx > 0) { started = true; idx--; render(); }
      });

      $('clear').addEventListener('click', function () {
        answers = new Array(STEPS.length).fill(null);
        idx = 0;
        started = false;
        last = null;
        $('mailform').hidden = false;
        $('send').disabled = false;
        $('mailstatus').hidden = true;
        $('result').hidden = true;
        render();
        $('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      $('again').addEventListener('click', function () {
        answers = new Array(STEPS.length).fill(null);
        idx = 0;
        started = false;
        last = null;
        $('mailform').hidden = false;
        $('send').disabled = false;
        $('mailstatus').hidden = true;
        $('result').hidden = true;
        render();
        $('quiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      function drawRadar(pcts) {
        var n = DIMENSIONS.length, R = 128, CX = 268, CY = 220;
        function pt(i, r) {
          var a = (i / n) * 2 * Math.PI - Math.PI / 2;
          return [CX + Math.cos(a) * r, CY + Math.sin(a) * r];
        }
        var out = [];
        [0.25, 0.5, 0.75, 1].forEach(function (f) {
          var p = [];
          for (var i = 0; i < n; i++) p.push(pt(i, R * f).map(function (v) { return v.toFixed(1); }).join(','));
          out.push('<polygon class="rr" points="' + p.join(' ') + '"/>');
        });
        for (var i = 0; i < n; i++) {
          var e = pt(i, R);
          out.push('<line class="ra" x1="' + CX + '" y1="' + CY + '" x2="' + e[0].toFixed(1) + '" y2="' + e[1].toFixed(1) + '"/>');
        }
        var shape = pcts.map(function (v, i) {
          return pt(i, R * Math.max(v, 3) / 100).map(function (z) { return z.toFixed(1); }).join(',');
        }).join(' ');
        out.push('<polygon class="rs" points="' + shape + '"/>');
        pcts.forEach(function (v, i) {
          var p = pt(i, R * Math.max(v, 3) / 100);
          out.push('<circle class="rd" cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="4.5"/>');
        });
        var lo = Math.min.apply(null, pcts);
        DIMENSIONS.forEach(function (d, i) {
          var p = pt(i, R + 28);
          var anchor = Math.abs(p[0] - CX) < 8 ? 'middle' : (p[0] > CX ? 'start' : 'end');
          var lines = d.axis.split('\n');
          lines.forEach(function (ln, k) {
            var y = p[1] + k * 16 - (lines.length - 1) * 8;
            out.push('<text class="rl' + (pcts[i] === lo ? ' weak' : '') + '" x="' + p[0].toFixed(1) +
              '" y="' + y.toFixed(1) + '" text-anchor="' + anchor + '">' + ln + '</text>');
          });
        });
        return '<svg viewBox="0 0 536 448" role="img" aria-label="Your nine dimension scores">' + out.join('') + '</svg>';
      }

      function finish() {
        var byDim = {};
        DIMENSIONS.forEach(function (d) { byDim[d.key] = 0; });
        STEPS.forEach(function (s, i) {
          if (!s.key) return;                 /* the role step scores nothing */
          byDim[s.key] += s.opts[answers[i]][1];
        });

        var pcts = DIMENSIONS.map(function (d) {
          return Math.round((byDim[d.key] / MAX_PER_DIM) * 100);
        });
        var overall = Math.round(pcts.reduce(function (a, b) { return a + b; }, 0) / pcts.length);
        var band = BANDS.filter(function (b) { return overall >= b.min; })[0];

        $('band-name').textContent = band.name + '. ' + overall + '%.';
        $('band-copy').textContent = band.copy;
        $('radar').innerHTML = drawRadar(pcts);

        /* Ties are real and common on a nine-question instrument, so
           report every dimension at the lowest score rather than silently
           picking the first. The radar already highlights all of them; the
           text used to name one, which read as a bug. */
        var lo = Math.min.apply(null, pcts);
        var lowIdx = [];
        pcts.forEach(function (v, i) { if (v === lo) lowIdx.push(i); });
        var lowDims = lowIdx.map(function (i) { return DIMENSIONS[i]; });
        var names = lowDims.map(function (d) { return d.label; });
        var joined = names.length === 1 ? names[0]
          : names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1];

        $('weak-dim').textContent = joined + ', ' + lo + '%';
        var edgeNames = [];
        lowDims.forEach(function (d) {
          var nm = EDGES[d.edge].name;
          if (edgeNames.indexOf(nm) === -1) edgeNames.push(nm);
        });
        $('weak-copy').textContent = names.length === 1
          ? 'Of the nine, this is where your own answers put you lowest. It sits inside ' + edgeNames[0] + '.'
          : 'Of the nine, these are tied lowest on your own answers. They sit inside ' +
            (edgeNames.length === 1 ? edgeNames[0] : edgeNames.slice(0, -1).join(', ') + ' and ' + edgeNames[edgeNames.length - 1]) + '.';

        var edgeAvgs = EDGES.map(function (_, k) {
          var mine = pcts.filter(function (_, i) { return DIMENSIONS[i].edge === k; });
          return Math.round(mine.reduce(function (a, b) { return a + b; }, 0) / mine.length);
        });
        var loEdgeVal = Math.min.apply(null, edgeAvgs);
        var loEdge = edgeAvgs.indexOf(loEdgeVal);

        /* The link follows the lowest EDGE, not the edge of the lowest
           dimension. Those come apart: one weak dimension does not make its
           edge the weakest overall, and sending someone to an edge that is
           not their lowest bar reads as an error. */
        var link = $('edge-link');
        link.href = '/' + EDGES[loEdge].slug + '/';
        link.textContent = 'Read about ' + EDGES[loEdge].name;

        var box = $('edge-scores');
        box.innerHTML = '';
        EDGES.forEach(function (ed, k) {
          var row = document.createElement('div');
          /* Amber marks the lowest bar. Marking anything else on a bar chart
             looks like a mistake even when the reasoning is sound. */
          /* Every edge at the minimum is marked, not just the first. Two bars
             the same length with only one of them amber reads as a bug. */
          row.className = 'escore' + (edgeAvgs[k] === loEdgeVal ? ' is-weak' : '');
          row.innerHTML = '<b>' + ed.name + '</b><span class="ebar"><i style="width:' + edgeAvgs[k] + '%"></i></span><span class="epct">' + edgeAvgs[k] + '%</span>';
          box.appendChild(row);
        });

        /* Held so the image and the email describe exactly what is on screen,
           rather than recomputing and risking a quiet drift between them. */
        last = {
          pcts: pcts, overall: overall, band: band, lo: lo,
          lowJoined: joined,
          edgeAvgs: edgeAvgs, loEdgeVal: loEdgeVal,
          roleLabel: answers[0] === null ? 'Role not given' : STEPS[0].opts[answers[0]][0]
        };

        $('qfill').style.width = '100%';
        $('qcount').textContent = 'Complete';
        $('result').hidden = false;
        $('result').classList.add('is-in');
        $('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      /* ---------- Keeping the result ----------

         The instrument scores in the browser and stores nothing, which is the
         right default and also means the result dies with the tab. Two exits.

         The image is drawn here with Canvas 2D rather than by rasterising the
         SVG above. Painting an SVG into a canvas drops every self-hosted
         @font-face, so the chart would come back in Times New Roman. Drawing
         the shapes and the text directly uses the fonts the page already
         loaded. */

      var last = null;   /* the finished result, held for the image and the email */

      function wrapLines(ctx, text, max) {
        var words = String(text).split(' '), lines = [], line = '';
        words.forEach(function (w) {
          var test = line ? line + ' ' + w : w;
          if (ctx.measureText(test).width > max && line) { lines.push(line); line = w; }
          else line = test;
        });
        if (line) lines.push(line);
        return lines;
      }

      function head(ctx, weight, size, track) {
        ctx.font = weight + ' ' + size + 'px "Archivo Narrow", Helvetica, Arial, sans-serif';
        try { ctx.letterSpacing = (track || 0) + 'px'; } catch (e) {}
      }
      function body(ctx, weight, size) {
        ctx.font = weight + ' ' + size + 'px "Inter", Helvetica, Arial, sans-serif';
        try { ctx.letterSpacing = '0px'; } catch (e) {}
      }

      var INK = '#141A22', AMBER = '#F2A93B', PALE = '#D7DCE4', WHITE = '#FFFFFF';
      var FAINT = 'rgba(215,220,228,.22)';

      function drawCard() {
        var W = 1200, H = 1460, S = 2;
        var c = document.createElement('canvas');
        c.width = W * S; c.height = H * S;
        var ctx = c.getContext('2d');
        ctx.scale(S, S);
        ctx.textBaseline = 'alphabetic';

        ctx.fillStyle = INK; ctx.fillRect(0, 0, W, H);
        /* The single left edge, the one structural habit carried over from
           every band on the site. */
        ctx.fillStyle = AMBER; ctx.fillRect(0, 0, 10, H);

        var L = 88, R = 1128, w = R - L;

        head(ctx, 700, 21, 2.5);
        ctx.fillStyle = AMBER;
        ctx.fillText('THE ENTERPRISE EDGE ASSESSMENT', L, 100);

        head(ctx, 700, 62, 0);
        ctx.fillStyle = WHITE;
        ctx.fillText(last.band.name + '. ' + last.overall + '%.', L, 178);

        body(ctx, 400, 24);
        ctx.fillStyle = PALE;
        var y = 224;
        wrapLines(ctx, last.band.copy, w).forEach(function (ln) {
          ctx.fillText(ln, L, y); y += 34;
        });

        /* ----- radar ----- */
        var n = DIMENSIONS.length, RR = 232, CX = 600, CY = y + 40 + RR;
        function pt(i, r) {
          var a = (i / n) * 2 * Math.PI - Math.PI / 2;
          return [CX + Math.cos(a) * r, CY + Math.sin(a) * r];
        }
        ctx.lineWidth = 1; ctx.strokeStyle = FAINT;
        [0.25, 0.5, 0.75, 1].forEach(function (f) {
          ctx.beginPath();
          for (var i = 0; i < n; i++) {
            var q = pt(i, RR * f);
            if (i === 0) ctx.moveTo(q[0], q[1]); else ctx.lineTo(q[0], q[1]);
          }
          ctx.closePath(); ctx.stroke();
        });
        for (var i = 0; i < n; i++) {
          var e = pt(i, RR);
          ctx.beginPath(); ctx.moveTo(CX, CY); ctx.lineTo(e[0], e[1]); ctx.stroke();
        }

        ctx.beginPath();
        last.pcts.forEach(function (v, i) {
          var q = pt(i, RR * Math.max(v, 3) / 100);
          if (i === 0) ctx.moveTo(q[0], q[1]); else ctx.lineTo(q[0], q[1]);
        });
        ctx.closePath();
        ctx.fillStyle = 'rgba(242,169,59,.22)'; ctx.fill();
        ctx.strokeStyle = AMBER; ctx.lineWidth = 4; ctx.lineJoin = 'round'; ctx.stroke();

        ctx.fillStyle = AMBER;
        last.pcts.forEach(function (v, i) {
          var q = pt(i, RR * Math.max(v, 3) / 100);
          ctx.beginPath(); ctx.arc(q[0], q[1], 7, 0, 2 * Math.PI); ctx.fill();
        });

        head(ctx, 600, 23, 0.4);
        DIMENSIONS.forEach(function (d, i) {
          var q = pt(i, RR + 30);
          var dx = q[0] - CX;
          ctx.textAlign = Math.abs(dx) < 12 ? 'center' : (dx > 0 ? 'left' : 'right');
          var weak = last.pcts[i] === last.lo;
          ctx.fillStyle = weak ? AMBER : PALE;
          head(ctx, weak ? 700 : 600, 23, 0.4);
          var lines = d.axis.split('\n');
          lines.forEach(function (ln, k) {
            ctx.fillText(ln, q[0], q[1] + k * 27 - (lines.length - 1) * 13 + 8);
          });
        });
        ctx.textAlign = 'left';

        /* ----- the nine, grouped under their edge ----- */
        var top = CY + RR + 96;
        ctx.strokeStyle = FAINT; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(L, top - 46); ctx.lineTo(R, top - 46); ctx.stroke();

        var colW = 320, gap = (w - colW * 3) / 2;
        EDGES.forEach(function (ed, k) {
          var x = L + k * (colW + gap);
          var weak = last.edgeAvgs[k] === last.loEdgeVal;
          var col = weak ? AMBER : PALE;

          head(ctx, 700, 27, 0);
          ctx.fillStyle = col;
          ctx.fillText(ed.name, x, top);
          ctx.textAlign = 'right';
          ctx.fillText(last.edgeAvgs[k] + '%', x + colW, top);
          ctx.textAlign = 'left';

          ctx.fillStyle = FAINT;
          ctx.fillRect(x, top + 16, colW, 8);
          ctx.fillStyle = col;
          ctx.fillRect(x, top + 16, colW * last.edgeAvgs[k] / 100, 8);

          var ry = top + 62;
          DIMENSIONS.forEach(function (d, i) {
            if (d.edge !== k) return;
            var isLo = last.pcts[i] === last.lo;
            body(ctx, isLo ? 600 : 400, 20);
            ctx.fillStyle = isLo ? AMBER : PALE;
            ctx.fillText(d.label, x, ry);
            ctx.textAlign = 'right';
            ctx.fillText(last.pcts[i] + '%', x + colW, ry);
            ctx.textAlign = 'left';
            ry += 36;
          });
        });

        /* ----- the finding, and the foot -----
           Anchored to the bottom edge rather than to the flow above it, so a
           band paragraph that wraps to three lines instead of four moves the
           slack into the middle instead of pushing this off the card. */
        ctx.strokeStyle = FAINT; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(L, H - 250); ctx.lineTo(R, H - 250); ctx.stroke();

        head(ctx, 700, 20, 2.4);
        ctx.fillStyle = AMBER;
        ctx.fillText('LOWEST OF THE NINE', L, H - 208);

        head(ctx, 700, 34, 0);
        ctx.fillStyle = WHITE;
        ctx.fillText(last.lowJoined, L, H - 166);

        body(ctx, 400, 20);
        ctx.fillStyle = 'rgba(215,220,228,.75)';
        ctx.fillText('The half day works through all nine, in the order a deal actually moves.',
          L, H - 126);

        head(ctx, 700, 22, 2.5);
        ctx.fillStyle = PALE;
        ctx.fillText('GETENTERPRISEEDGE.COM', L, H - 58);
        body(ctx, 400, 19);
        ctx.fillStyle = 'rgba(215,220,228,.55)';
        ctx.textAlign = 'right';
        ctx.fillText(last.roleLabel, R, H - 58);
        ctx.textAlign = 'left';

        return c;
      }

      /* The fonts have to be resident before anything is painted, or the card
         silently falls back to Helvetica and looks like a different brand. */
      function withFonts(fn) {
        if (!document.fonts || !document.fonts.load) { fn(); return; }
        Promise.all([
          document.fonts.load('700 62px "Archivo Narrow"'),
          document.fonts.load('600 23px "Archivo Narrow"'),
          document.fonts.load('400 24px "Inter"'),
          document.fonts.load('600 20px "Inter"')
        ]).then(fn, fn);
      }

      $('dl').addEventListener('click', function () {
        if (!last) return;
        withFonts(function () {
          drawCard().toBlob(function (blob) {
            var u = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = u;
            a.download = 'enterprise-edge-assessment.png';
            document.body.appendChild(a); a.click(); a.remove();
            setTimeout(function () { URL.revokeObjectURL(u); }, 4000);
          }, 'image/png');
        });
      });

      var mailform = $('mailform'), status = $('mailstatus'), sendBtn = $('send');
      function say(msg, bad) {
        status.textContent = msg;
        status.className = 'keep-status' + (bad ? ' bad' : '');
        status.hidden = false;
      }

      mailform.addEventListener('submit', function (ev) {
        ev.preventDefault();
        if (!last) return;
        var addr = $('mailto-addr').value.trim();
        if (!/^[^@\s]+@[^@\s.]+\.[^@\s]+$/.test(addr)) {
          say('That address does not look complete. Check it and try again.', true);
          $('mailto-addr').focus();
          return;
        }
        sendBtn.disabled = true;
        say('Sending.');
        withFonts(function () {
          var png = drawCard().toDataURL('image/png');
          fetch('/api/results', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            /* Numbers and the card, and nothing else. Every word in the
               email is written on the server. Sending it labels and band
               copy from here would mean an endpoint that emails whatever
               text it is handed, from our own domain. */
            body: JSON.stringify({
              email: addr,
              company: $('ee-hp').value,
              role: last.roleLabel,
              pcts: last.pcts,
              png: png
            })
          }).then(function (r) {
            if (!r.ok) throw new Error(String(r.status));
            say('Sent. It is on its way to ' + addr + '. If it does not show up in a minute, look in your spam folder.');
            mailform.hidden = true;
          }).catch(function () {
            sendBtn.disabled = false;
            say('That did not go through. Download the image instead, or email bruce@inspireyourbuyers.com and he will send it over.', true);
          });
        });
      });

      render();
    })();
  </script>

  <style>
    .qcard{max-width:46rem}
    .qtop{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
    .qcount{font-family:var(--font-head);font-weight:700;font-size:.95rem;
      letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0}
    .qclear{background:none;border:0;padding:0;cursor:pointer;
      font-family:var(--font-head);font-weight:700;font-size:.95rem;
      letter-spacing:.08em;text-transform:uppercase;color:var(--bronze)}
    .qclear:hover{text-decoration:underline}
    .qtrack{height:3px;background:var(--line);margin:.7rem 0 2.25rem;border-radius:2px;
      overflow:hidden}
    .qtrack i{display:block;height:100%;width:0;background:var(--bronze);
      transition:width .3s cubic-bezier(.22,.61,.36,1)}

    .qdim{font-family:var(--font-head);font-weight:700;font-size:.9rem;
      letter-spacing:.12em;text-transform:uppercase;color:var(--bronze);margin:0 0 .7rem}
    .qtext{font-size:clamp(1.5rem,3.2vw,2.1rem);line-height:1.2;color:var(--ink);
      margin:0 0 1.75rem;max-width:34ch}

    .qopts{list-style:none;margin:0;padding:0;display:grid;gap:.6rem}
    /* EVERY selector below is :global on purpose. Astro scopes a page's styles
       by stamping data-astro-cid-* on the markup it can see at build time.
       These elements are built by the script at run time, so they never get
       that attribute and a scoped selector matches nothing at all. The answer
       buttons, the radar and the edge bars are all in that category.

       This is the exact trap the inspireyourbuyers.com README documents, and
       it presents as no styling rather than wrong styling: the radar rendered
       as a solid black blob because an unstyled SVG polygon defaults to black
       fill, and the edge bars vanished entirely. */
    .qopts :global(.qopt){display:block;width:100%;text-align:left;cursor:pointer;
      font-family:var(--font-body);font-size:1.1rem;line-height:1.4;color:var(--ink);
      background:var(--white);border:1px solid var(--line);border-radius:2px;
      padding:1rem 1.2rem;transition:border-color .15s ease,background .15s ease}
    .qopts :global(.qopt:hover){border-color:var(--bronze);background:var(--bone-2)}
    .qopts :global(.qopt:focus-visible){outline:3px solid var(--amber);outline-offset:2px}
    /* The previously chosen answer stays marked, so stepping Back shows what
       you said rather than a blank slate. */
    .qopts :global(.qopt[aria-pressed="true"]){border-color:var(--bronze);
      border-left-width:4px;font-weight:600}

    .qfoot{margin-top:1.75rem;min-height:2rem}
    .qback{background:none;border:0;padding:0;cursor:pointer;
      font-family:var(--font-head);font-weight:700;font-size:1.05rem;
      color:var(--ink);border-bottom:2px solid var(--amber);padding-bottom:2px}
    .qback:hover{color:var(--bronze)}

    .result-grid{display:grid;grid-template-columns:1fr;gap:2.5rem;margin-top:2.5rem}
    @media (min-width:1000px){
      /* The radar column drove readability more than any font size did. At
         380px a 536-unit viewBox scaled every label down by nearly a third,
         so 13px type arrived as 9px. The column now carries the chart at
         close to its drawn size. */
      .result-grid{grid-template-columns:minmax(0,540px) minmax(0,1fr);gap:3.25rem;align-items:start}
    }
    /* The viewBox carries the labels rather than letting them spill past it.
   overflow:visible used to do that job, which worked until the SVG sat in a
   grid column narrower than the labels wanted and they clipped. */
    .radar-wrap{max-width:540px;width:100%}
    .radar-wrap :global(svg){width:100%;height:auto;display:block}
    .radar-wrap :global(.rr){fill:none;stroke:rgba(215,220,228,.22);stroke-width:1}
    .radar-wrap :global(.ra){stroke:rgba(215,220,228,.22);stroke-width:1}
    .radar-wrap :global(.rs){fill:var(--amber);fill-opacity:.22;stroke:var(--amber);
      stroke-width:2.5;stroke-linejoin:round}
    .radar-wrap :global(.rd){fill:var(--amber)}
    .radar-wrap :global(.rl){font-family:var(--font-head);font-weight:600;
      font-size:14px;letter-spacing:.02em;fill:var(--pale)}
    .radar-wrap :global(.rl.weak){fill:var(--amber);font-weight:700}

    .result-read h3{color:var(--white);margin-bottom:.5rem}
    #edge-scores :global(.escore){display:grid;grid-template-columns:1fr;gap:.3rem;
      margin:0 0 1rem;align-items:center}
    @media (min-width:520px){
      #edge-scores :global(.escore){grid-template-columns:11rem minmax(0,1fr) 3rem;gap:1rem}
    }
    #edge-scores :global(.escore b){font-family:var(--font-head);font-weight:600;
      font-size:1.1rem;color:var(--pale)}
    #edge-scores :global(.ebar){background:rgba(215,220,228,.16);height:.7rem;
      border-radius:2px;overflow:hidden;display:block}
    #edge-scores :global(.ebar i){display:block;height:100%;background:var(--pale);
      border-radius:2px}
    #edge-scores :global(.epct){font-family:var(--font-head);font-weight:700;
      font-size:1.05rem;color:var(--pale);text-align:right}
    #edge-scores :global(.escore.is-weak b),
    #edge-scores :global(.escore.is-weak .epct){color:var(--amber)}
    #edge-scores :global(.escore.is-weak .ebar i){background:var(--amber)}

    #again{background:none;border:0;padding:0 0 2px;cursor:pointer}
  </style>

</Base>
