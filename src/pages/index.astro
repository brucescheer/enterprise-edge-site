---
import Base from '../layouts/Base.astro';
import { EDGES, CITIES, FACULTY, HAS_DATES, HAS_REGISTRATION, NEXT_SESSION, SESSION_INDEX } from '../data/program';

const title = 'The Enterprise Edge: A Half-Day Masterclass for Enterprise Revenue Leaders';
const description =
  'A half day for revenue leaders and founders selling to large organizations where a buying committee decides. Bruce Scheer, Dean Edwards and Sandy Yu on getting customers to say yes, getting the deal through approval, and expanding the account.';
const canonical = 'https://getenterpriseedge.com/';

/* Dated cities first and soonest first, then the ones still to be scheduled.
   The tiles used to rely on the order of the CITIES array, which was fine
   while exactly one city had a date. With two, array order put the later
   session above the sooner one and below a city with no date at all.
   Compared as Dates rather than as strings: these carry different UTC
   offsets, so comparing the ISO text would not reliably sort them. */
const ORDERED_CITIES = [
  ...CITIES.filter((c) => c.startDate).sort(
    (a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime()
  ),
  ...CITIES.filter((c) => !c.startDate),
];

/* "In Singapore that is The American Club" was hardcoded, which would have
   quietly become wrong the moment a venue changed or a second one was
   confirmed. Built from the data instead.

   A venue whose name already contains its city does not get the city again.
   With two venues "City Club Los Angeles in Los Angeles" was a small
   clumsiness. With five it ran to "Tower Club Dallas in Dallas and The
   Austin Club in Austin" in one sentence, which reads as though nobody
   proofread it. */
const VENUES = CITIES.filter((c) => c.venue);
const VENUE_LIST = VENUES.map((c, i) => {
  const clause = c.venue.includes(c.city) ? c.venue : `${c.venue} in ${c.city}`;
  if (i === 0) return clause;
  if (i === VENUES.length - 1) return ` and ${clause}`;
  return `, ${clause}`;
}).join('');

const jsonLd = {
  '@graph': [
    {
      '@type': 'Course',
      '@id': 'https://getenterpriseedge.com/#course',
      name: 'The Enterprise Edge Masterclass',
      description,
      provider: { '@id': 'https://getenterpriseedge.com/#organization' },
      /* Only cities with a confirmed date become CourseInstance entries. A
         placeholder instance with no date and no venue is not something a
         search engine can do anything useful with, and it invites a rich
         result advertising a session that has no date. */
      hasCourseInstance: CITIES.filter((c) => c.startDate).map((c) => ({
        '@type': 'CourseInstance',
        courseMode: 'onsite',
        name: `The Enterprise Edge: ${c.city}`,
        startDate: c.startDate,
        endDate: c.endDate,
        location: {
          '@type': 'Place',
          ...(c.venue ? { name: c.venue } : {}),
          address: {
            '@type': 'PostalAddress',
            addressLocality: c.city,
            ...(c.region ? { addressRegion: c.region } : {}),
          },
        },
        ...(c.lumaUrl ? { url: c.lumaUrl } : {}),
      })),
    },
  ],
};
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>  <section class="band band-ink hero has-figure">
    {/* The symbol at scale, bleeding off the right edge. It gives the hero
        depth without stock photography and reuses artwork we already have.
        Decorative, so it is hidden from assistive technology and it is the
        first thing to go when the viewport gets narrow, where it would
        otherwise sit behind the headline. */}
    <img class="hero-figure" src="/assets/ee-symbol.png" alt="" aria-hidden="true" />
    <div class="wrap">
      <p class="eyebrow">A half day for revenue leaders and founders selling to large organizations</p>
      {/* One sentence per line so the three Gets stack and line up, Cindy's
          note. "Damn" came out on the 15 September call: it reads as
          off-putting in Singapore and across APAC, and the masterclass runs
          there. */}
      <h1 class="h1-stack"><span>Get them to say yes.</span> <span>Get the deal approved.</span> <span>Get them to expand.</span></h1>
      <p class="lede">Three hours on the full arc of an enterprise customer, with three people who have each spent a career on one part of it.</p>

      {/* The provocation, and under it the fit filter Dean asked for on the
          10 September call. Rewritten 21 September for a CRO reading this
          with a 2027 plan on the desk. The provocation deliberately does not
          diagnose the reader: "will not fix a weak link" implies one exists
          without asserting which, where an earlier draft asserted one
          motion definitely fails, which reads as presumptuous to people who
          run vendor reviews for a living.

          Fit is by the buyer's complexity, not the seller's size. Bruce, 21
          September: the audience does not have to be from a big company,
          but they should be selling to big companies with complex
          purchasing. That is where the program shines and it is the one
          filter that holds in every city, Singapore included. */}
      <p class="qualifier">A bigger revenue target will not fix a weak link.</p>
      <p class="qualifier-body">Before you commit to your 2027 plan, pressure-test how your team wins preference, earns approval and turns delivered value into expansion. Come with the motion that is costing you the most.</p>
      {/* Clarity audit: the deliverables lived five screens down inside the
          outline cards, so a skimmer saw promises and no objects. One line
          here, in the same order as the three hours. */}
      <p class="qualifier-body">You leave with a positioning and narrative canvas for your team, an approval-readiness framework, a map of the three leaks that drain expansion, and a read on which motion is costing you the most.</p>
      {/* Was "Bring a deal that stalled or an account that should be growing."
          Changed 22 September: the room is pitched at executives, and a
          revenue leader's problem is the pattern behind the deals, not one
          deal. The deal stays as the exercise inside the room; the ask on
          the page is the motion. Same change in the agenda and the meal. */}
      {/* "You do not have to be a large company. Your customers do" used to
          sit here. Sandy asked for it out on 22 September and Bruce agreed:
          the principle is that copy invites and the registration form
          filters, so nothing on the page tells a reader who cannot come.
          Who will be in the room still describes the audience, positively.
          The registration question is now the filter and has to carry the
          buying-committee test rather than a seller headcount. */}
      {/* Two buttons of equal weight. The assessment stays first because it
          is step one of the four at the foot of this page and because a
          reader who has seen their own shape arrives at the dates knowing
          why. The city button is a button rather than a text link so that
          someone who already knows they are coming is not made to hunt. Warm
          outreach should link straight to the city's Luma event and never
          hit this hero at all. */}
      {/* Clarity audit, 23 September: a first-time visitor could not find
          the price anywhere on the page ("token fee" is not a number), and
          the primary button was the soft ask while the first city was
          sixteen days out. Seat first, assessment second, price stated. */}
      <div class="cta-pair">
        <a class="btn" href="#dates">Choose your city</a>
        <a class="btn btn-ghost" href="/assessment/">Find your weak link</a>
      </div>
      <p class="fine" style="margin-top:.9rem">Half a day, in person. US$99 a seat, S$99 in Singapore. The assessment is nine questions, about three minutes, no sign-in.</p>

      {/* The dates used to sit 82% of the way down the page, so a reader
          could get most of the way through without learning that anything
          was happening in four weeks. This says it in the first screen.

          Rendered from build-time data and corrected in the browser, because
          a static site is only as fresh as its last deploy and this line goes
          wrong the day a session passes. */}
      {NEXT_SESSION && (
        <p class="next-session" data-sessions={JSON.stringify(SESSION_INDEX)}>
          <span class="ns-label">Next session</span>
          <a class="ns-link" href="#dates">
            <b class="ns-city">{NEXT_SESSION.city}</b>
            <span class="ns-date">{NEXT_SESSION.date}</span>
          </a>
        </p>
      )}
    </div>
  </section>
  <section class="band band-bone band-measure">
    <div class="wrap">
      <p class="eyebrow">Problem</p>
      <h2>Upmarket revenue misfires.</h2>
      {/* The section used to open on a three paragraph windup: everything
          right and still lose, strong product and a willing champion, then
          the stall. Bruce cut all three. Dean's sentence was doing the real
          work underneath them and now opens the section itself, split so the
          claim carries as the lede and the mechanics follow as body copy.
          Same words, same order, no windup. */}
      <p class="lede">Enterprise revenue depends on three connected motions: win preference, earn approval, and expand the account.</p>
      {/* The third motion was "prove value after the sale", which names the
          work. "Expand the account" names the result, matches Sandy's hour
          and the third promise, and is what the outreach note says. Bruce,
          22 September. */}
      <p>Most revenue organizations are strong at one of the three, adequate at the second, and quietly losing money on the third. The trouble is that the one you are worst at never sends you a report.</p>
      {/* Three scenes, one per edge, in the order the edges run. These sit
          outside the toggle because they are the reader's recognition
          moment. The connecting line is what makes a CMO, a customer leader,
          a COO or a founder read on: each scene can look like it belongs to
          someone else's function and every one of them lands on the growth
          they answer for. Note the problem stays inside the customer's
          organization, which the closing line below still says. Internal
          handoffs are a reason to attend, not the diagnosis. */}
      <p>Your champion likes the story but cannot make the business case. A deal slips while Finance, Security and Procurement work through questions your team did not anticipate. A satisfied customer renews, but the expansion you planned never comes.</p>
      <p>Each can look like someone else&rsquo;s problem. All of them affect the growth you are responsible for.</p>
      {/* PROBLEM, OUTCOME, PATH: the gist stays open and the depth sits behind
          a toggle. Cindy's note: all three beats in full were overwhelming,
          and a reader should be able to take the gist and keep moving down
          the page, or stop and go deeper. <details> because it needs no
          script, is keyboard and screen reader native, and search engines
          still read what is inside it. The lines left open are the ones the
          next beat depends on: "the one you are worst at" is what the
          Outcome's "what if" answers. */}
      <details class="more-detail">
        <summary>Why it happens</summary>
        <div class="more-body">
          <p>They fail in completely different ways. Winning preference is a narrative and business case problem. Earning approval is a commercial, legal, security and governance problem. Proving value afterward is an outcomes and relationships problem.</p>
      {/* Both figures were read off the Gartner press releases they link to,
           on 2026-09-09, and both pages state the number in those words. They
           replaced a Forrester "86% stall" and a JOLT Effect "40 to 60% no
           decision" that had been carried here unverified and are not in
           Bruce's own verified statistics bank on inspireyourbuyers.com.

           Anything that goes in this paragraph has to survive the same check:
           open the source, find the number, or do not publish it. */}
          <p>The numbers bear it out. 64% of B2B buyers cannot tell one brand&rsquo;s digital experience from another&rsquo;s (<a href="https://www.gartner.com/en/newsroom/press-releases/gartner-says-b2b-sales-organizations-need-to-give-customers-a-se" target="_blank" rel="noopener noreferrer">Gartner</a>). And when the information reaching them contradicts itself, they are 153% more likely to settle for something smaller and less disruptive than they set out to buy (<a href="https://www.gartner.com/en/newsroom/press-releases/2019-07-29-gartner-reveals-new-b2b-sales-approach-to-win-in-toda" target="_blank" rel="noopener noreferrer">Gartner</a>).</p>
          <p>That is the shrink, measured. It does not arrive with a reason attached.</p>
        </div>
      </details>
      {/* Dean's line, off the workshop collateral. The site had never said
          this plainly anywhere, and it is the hinge the whole program turns
          on: the answer is not in your CRM, it is in a room you were not
          invited to. */}
      <p class="emph">The reason is usually somewhere inside the customer organization, in a meeting you were not in.</p>
    </div>
  </section>
  <section class="band band-bone2 band-measure">
    <div class="wrap">
      <p class="eyebrow">Outcome</p>
      <h2>High performing revenue engine.</h2>
      {/* The lede here used to be "What it looks like when all three motions
          go your way", which labels the section without joining it to the one
          above. "What if" is the join, and it calls back to the last line of
          the Problem section: the one you are worst at never sends you a
          report. Same move Bruce uses on inspireyourbuyers.com. */}
      <p class="lede">What if the one you are worst at stopped costing you quietly?</p>
      <p>Then your deals earn preference, survive approval, deliver visible value, and open a stronger path to renewal and expansion.</p>
      <details class="more-detail">
        <summary>What that looks like</summary>
        <div class="more-body">
          <p>Your champion can tell the buying group the same value story you would have told, in their own words, without you there to correct it.</p>
          <p>The wider organization gets the answers it needs. Procurement can defend the commercial logic. Finance understands the economics. Security, Legal and governance stakeholders can see how risk will be managed. When price pressure comes, the conversation stays anchored in total value rather than collapsing into discounting.</p>
          <p>After the sale, the customer can see what was delivered, why it mattered, and where additional value can be created.</p>
        </div>
      </details>
      <p class="emph">You will not be in every meeting that decides the deal. The system has to work when you are not in the room.</p>
    </div>
  </section>
  <section class="band band-ink" id="edges">
    <div class="wrap">
      <p class="eyebrow">Path</p>
      {/* Was "Get the Enterprise Edge." The brand name as a verb reads as a
          slogan to a first-time visitor; the section is the path, so the
          heading says what it is. The spine is unchanged: the lede below
          still names the problem and the outcome on the way in. */}
      <h2>The masterclass.</h2>
      {/* Names the problem and the outcome on the way into the solution, so
          the spine is visible rather than just present. Without it this
          section opened on "three jobs, three hours" and the reader had to
          hold the thread themselves. */}
      <p class="lede">Overcoming upmarket revenue misfires and building a high performing revenue engine: that is the goal, and this masterclass is how.</p>
      <p>Three jobs. Three hours. Three people who have each spent a career on one of them. Most programs take one of the three, and the gaps between them are where the revenue actually goes.</p>

      {/* The three hours in leader language, so a CRO reads what is being
          built rather than what is being covered. Same three lines as the
          outreach note, kept identical on purpose. */}
      <p>Bruce&rsquo;s hour is the positioning and go-to-market narrative your team sells from. Dean&rsquo;s is getting through complex enterprise approvals without stalling and without giving the margin away. Sandy&rsquo;s is retention and expansion after signature.</p>

      {/* Titles the numbered list so the three edges read as the shape of
          the morning rather than as three loose profiles. The section
          further down carries the hour by hour with doors and the meal;
          this is the outline, that is the schedule. */}
      <h3 class="edges-title">Half-day outline</h3>

      <div class="edges">
        {EDGES.map((e) => (
          <article class="edge">
            <div class="edge-num" aria-hidden="true">{e.num}</div>
            <div>
              <p class="edge-domain">{e.domain}</p>
              <h3><a href={`/${e.slug}/`}>{e.name}</a></h3>
              <p class="edge-promise">{e.promise}</p>
              <p>{e.blurb}</p>
              {/* Visible on purpose. Astra's review and the CRO read both
                  landed on the same point: what you leave with is the most
                  persuasive line in each hour, and it was folded away. */}
              {e.takeaway && <p class="edge-takeaway">{e.takeaway}</p>}
              <details class="more-detail">
                <summary>What this hour covers</summary>
                <div class="more-body">
                  <ul class="edge-disciplines">
                    {e.disciplines.map((d) => <li set:html={d} />)}
                  </ul>
                  {e.extra && <p class="fine" style="margin-top:1rem" set:html={e.extra} />}
                </div>
              </details>
            </div>
            <div class="edge-who">
              {/* Portrait comes from FACULTY, matched on speaker name, so a
                  photo is stored once and appears everywhere that person does. */}
              {FACULTY.find((f) => f.name === e.speaker)?.photo && (
                <img
                  src={FACULTY.find((f) => f.name === e.speaker).photo}
                  alt={e.speaker}
                  width="256"
                  height="256"
                  loading="lazy"
                />
              )}
              <b>{e.speaker}</b>
              <span>{e.job}</span>
              {/* Clarity audit: the home page introduced three people with
                  no reason to believe them. One proof line each, drawn from
                  the bios on Who We Are so the two pages agree. */}
              {e.proof && <span class="edge-proof">{e.proof}</span>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="band band-ink" id="agenda">
    <div class="wrap">
      <p class="eyebrow">The half day</p>
      {/* Opportunity, not problem. The page already spent a whole band
          naming the problem, and by the time a reader reaches the schedule
          they have been through the outcome and the path. Calling the
          morning a problem here walks them back a beat. */}
      <h2>Three connected sessions. One enterprise revenue opportunity.</h2>
      <p class="lede">Interactive, practical and candid, with working frameworks, your own revenue motions on the table, and time to compare notes with senior peers.</p>

      <ul class="agenda">
        <li><b>Doors</b><span>Drinks and light networking<i>Come early. The best conversations start before the first slide.</i></span></li>
        <li><b>Hour 1</b><span>The Value Edge, with Bruce Scheer<i>Find Value, Communicate Value, Quantify Value.</i></span></li>
        <li><b>Hour 2</b><span>The Approval Edge, with Dean Edwards<i>What Procurement, Finance, Legal, InfoSec and AI governance actually evaluate.</i></span></li>
        <li><b>Hour 3</b><span>The Expansion Edge, with Sandy Yu<i>Making delivered value visible so customers renew, expand and advocate.</i></span></li>
        <li><b>The meal</b><span>Debrief, and no rush to leave<i>Come with the motion that is costing you the most. That is the conversation.</i></span></li>
      </ul>

      <p class="fine" style="margin-top:2rem">The exact schedule varies by city, but every session includes all three edges, practical application, and time for peer discussion. Limited to twenty-five participants a city, approved in advance, to keep the conversation relevant and at the right level.</p>

      {/* The bridge to paid work, placed after the agenda so the first
          decision on the page stays the seat. The distinction it draws is
          the true one: the public room works from examples, in-house works
          from the team's own deals. Written as "we", never as one of us. */}
      <div class="bridge">
        <h3>Bring this work to your revenue team.</h3>
        <p>The public masterclass introduces the three connected motions. In-house, we work with your team&rsquo;s stalled deals, approval challenges and accounts with room to grow, at your sales kickoff, a leadership offsite, or as a focused engagement.</p>
        <p><a class="more" href="/work-with-us/">Explore working with us</a></p>
      </div>
    </div>
  </section>
  <section class="band band-bone band-measure">
    <div class="wrap">
      <p class="eyebrow">The room</p>
      <h2>First-class venues. The room is part of the program.</h2>
      {/* Venues listed from the data so this sentence cannot go stale or
          name a room we are no longer in. */}
      <p>We run these in the best rooms we can find: {VENUE_LIST}.</p>

      {/* Two paragraphs here used to make the peer argument twice, one of
          them word for word: "running revenue organizations at your scale,
          working the same problems on different accounts" appeared in both.
          That was introduced when the old "What you leave with" band was
          folded into this section. Merged into one. */}
      <p>That is not hospitality for its own sake. You are giving us a working morning out of a week that did not have one spare, and the room decides whether the conversation stays polite or gets somewhere.</p>
      {/* The peer argument used to live in this sentence. It moved out when
          Who will be in the room moved directly underneath: that section is
          named for those people and describes them in full, so saying it
          here too put the same claim in two consecutive bands. This keeps
          the meal and the cap, which are this section's own. */}
      <p>Where a session runs into a meal, the meal is on the agenda rather than after it. An hour with the people in this room over a proper meal is not a side effect of the format. It is half the reason we cap it.</p>
      <p>A seat costs a token fee, there so that a reserved seat is a used seat.</p>
      {/* Venue photographs identify where each session is held. The site
          makes no claim that a venue hosts, sponsors or endorses the
          program, and the alt text says "the venue in" for that reason. */}
      <div class="venues">
        {CITIES.filter((c) => c.venuePhoto).map((c) => (
          <figure class="venue">
            <img
              src={c.venuePhoto}
              alt={`${c.venue}, the venue in ${c.city}`}
              loading="lazy"
              style={c.venuePhotoPosition ? `object-position:${c.venuePhotoPosition}` : undefined}
            />
            <figcaption>
              <b>{c.venue}</b>
              <span>{c.city}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <section class="band band-bone2 band-measure">
    <div class="wrap">
      {/* "Should be" made this a qualification test. The hero now does that
          job, in one line, before the first ask. So this is "will be", and
          its subject changed with its name: not whether you qualify, but who
          is sitting next to you and why that seat is worth the morning.

          It sits after The room for the same reason. Up at position three it
          interrupted the spine between the problem and the outcome. Here the
          page shows you the room and then tells you who is in it, which is
          the order anyone would ask in.

          Four paragraphs came out. The two describing the reader's symptoms
          were the Problem section again. The one listing where the three of
          us have worked was about us, not about the room, and it is on Who
          We Are where it belongs. The selective exceptions line went too;
          attendance is approved one at a time, so an exception can be made
          quietly rather than advertised. */}
      <p class="eyebrow">Who will be in the room</p>
      {/* TWENTY-FIVE IS A CAP, NOT AN ATTENDANCE FIGURE. This heading read
          "Twenty-five peers" and the paragraph under it said "twenty-five of
          them", both of which promise a count we cannot guarantee. If twenty
          turn up, the page has misled them. Bruce caught it.

          The whole site now says "limited to twenty-five participants ... to
          keep the conversation relevant and at the right level", Sandy's
          wording from 22 September, which Bruce approved. It describes the
          limit and the reason for it, not the turnout. Never say twenty-
          five people will be there. */}
      <h2>Peers with the same problem.</h2>
      {/* The 50-seller and $100 million bar came out on the 15 September
          call. Sandy's marketing coach made the case that it shut out mid-
          market teams moving upmarket, who need this most. The agreed line
          is B2B companies with revenue teams challenged by the complexities
          of selling to the enterprise. Approval in advance is what keeps the
          room viable now the headline filter is wider. */}
      <p>CROs, Chief Sales Officers, CMOs, Chief Customer Officers, COOs responsible for revenue, and founders, at B2B companies of any size selling high-consideration solutions into large organizations where a buying committee has to say yes. That includes teams moving upmarket that have not won the first one yet. Limited to twenty-five participants, each one approved in advance, to keep the conversation relevant and at the right level.</p>
      <p>Everyone there is selling into the enterprise and quietly losing money on one of the three motions. Probably not the same one as you. You will hear from your peers about their toughest challenges when selling to the enterprise, and that is what makes the seat next to you worth as much as the agenda.</p>
      {/* An option, not a default. Three seats per company as the standard
          invitation would let eight firms fill the room and flatten the mix
          that the paragraph above is selling. The approval step is the
          mechanism that keeps the mix, so the copy points at it. */}
      <p>If a colleague owns one of the three motions, they are welcome to request a seat as well. The approval step is how we keep the mix of companies and roles right.</p>
      {/* Dean's list, off the collateral, and better than what was here:
          four scenes instead of three abstractions, and one of them lands on
          each of the three edges. Recast for house rule 1, since his had a
          hyphen doing dash work in the last item. */}
      <p>Bring the deals that do not make sense. The opportunity everyone thought was healthy. The champion who went quiet. The deal that changed during approval. The account you won and have not expanded.</p>
    </div>
  </section>
  <section class="band band-ink" id="dates">
    <div class="wrap">
      <p class="eyebrow">Cities</p>
      <h2>{HAS_DATES ? 'Where and when' : 'Where we’re running it'}</h2>
      <p class="lede">
        {HAS_REGISTRATION
          ? 'Each city runs its own Enterprise Edge Masterclass, with its own registration. Pick yours to reserve a seat.'
          : 'Each city runs as its own session, in a first-class venue. Limited to twenty-five participants, approved before they are confirmed, to keep the conversation relevant and at the right level. Registration opens city by city.'}
      </p>

      {/* Three states per city, in ORDERED_CITIES order so the next session
          leads. A tile links only when there is genuinely an event page
          behind it; a dated city without one says so rather than looking
          clickable and doing nothing. */}
      <div class="dates">
        {ORDERED_CITIES.map((c) => (
          c.lumaUrl ? (
            <a class="date is-open" href={c.lumaUrl} target="_blank" rel="noopener noreferrer">
              <b>{c.city}</b>
              <span class="when">{c.date}</span>
              {c.doors && <span class="detail">Doors {c.doors}</span>}
              {c.time && <span class="detail">{c.time}</span>}
              {c.venue && <span class="detail">{c.venue}</span>}
              {c.venueAddress && <span class="detail">{c.venueAddress}</span>}
              {c.meal && <span class="detail">{c.meal}</span>}
              {c.price && <span class="detail price">{c.price}</span>}
              <span class="go">Reserve a seat</span>
            </a>
          ) : c.date ? (
            <div class="date is-set">
              <b>{c.city}</b>
              <span class="when">{c.date}</span>
              {c.doors && <span class="detail">Doors {c.doors}</span>}
              {c.time && <span class="detail">{c.time}</span>}
              {c.venue && <span class="detail">{c.venue}</span>}
              {c.venueAddress && <span class="detail">{c.venueAddress}</span>}
              {c.meal && <span class="detail">{c.meal}</span>}
              {c.price && <span class="detail price">{c.price}</span>}
              <span class="tbd">Registration opens soon</span>
            </div>
          ) : (
            <div class="date">
              <b>{c.city}</b>
              <span class="tbd">Dates soon</span>
            </div>
          )
        ))}
      </div>

      <div class="cta-pair">
        <a class="btn" href="/assessment/">Find your weak link</a>
        <a class="btn btn-ghost" href="/work-with-us/">Bring The Enterprise Edge in-house</a>
      </div>
    </div>
  </section>
