---
import '../styles/brand.css';
import { LUMA_URL, HAS_REGISTRATION } from '../data/program';

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = 'https://getenterpriseedge.com/assets/ee-og-1200x630.png',
  ogImageAlt = 'The Enterprise Edge. Get them to say yes, get the damn deal closed, get them to expand.',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1',
  jsonLd = null,
} = Astro.props;

/* Identity nodes ship on every page, not just the homepage, so each page's
   graph is self-contained. Cross-page @id reuse is valid linked data but
   validators and crawlers read one page at a time.

   schema.org has no "three people who run a thing together" type, so this
   models the program as an Organization with three named members and makes no
   legal claims about itself: no address, no tax ID, no founder. That is the
   accurate shape for a collaboration, and it is also the quiet way to be
   accurate. The site does not advertise the arrangement to readers. */
const SITE_GRAPH = [
  {
    '@type': 'Organization',
    '@id': 'https://getenterpriseedge.com/#organization',
    name: 'The Enterprise Edge',
    url: 'https://getenterpriseedge.com/',
    description:
      'A half-day masterclass on the three jobs that decide enterprise revenue: acquisition, approval and expansion. Led by Bruce Scheer, Dean Edwards and Sandy Yu.',
    member: [
      { '@id': 'https://getenterpriseedge.com/#bruce' },
      { '@id': 'https://getenterpriseedge.com/#dean' },
      { '@id': 'https://getenterpriseedge.com/#sandy' },
    ],
  },
  {
    '@type': 'Person',
    '@id': 'https://getenterpriseedge.com/#bruce',
    name: 'Bruce Scheer',
    jobTitle: 'Go-to-market narrative strategist',
    sameAs: ['https://inspireyourbuyers.com/'],
  },
  {
    '@type': 'Person',
    '@id': 'https://getenterpriseedge.com/#dean',
    name: 'Dean Edwards',
    jobTitle: 'Former Fortune 500 Chief Procurement Officer',
  },
  {
    '@type': 'Person',
    '@id': 'https://getenterpriseedge.com/#sandy',
    name: 'Sandy Yu',
  },
  {
    '@type': 'WebSite',
    '@id': 'https://getenterpriseedge.com/#website',
    url: 'https://getenterpriseedge.com/',
    name: 'The Enterprise Edge',
    publisher: { '@id': 'https://getenterpriseedge.com/#organization' },
  },
];
const pageNodes = jsonLd ? (jsonLd['@graph'] ?? [jsonLd]) : [];
const merged = [];
const seen = new Set();
for (const node of [...SITE_GRAPH, ...pageNodes]) {
  const id = node['@id'];
  if (id) {
    if (seen.has(id)) continue;
    seen.add(id);
  }
  merged.push(node);
}
const graphLd = { '@context': 'https://schema.org', '@graph': merged };

const NAV = [
  { href: '/#edges', label: 'The Three Edges' },
  { href: '/assessment/', label: 'Assessment' },
  { href: '/#dates', label: 'Dates' },
  { href: '/faculty/', label: 'Who We Are' },
  { href: '/work-with-us/', label: 'Work With Us' },
];

const here = Astro.url.pathname;
const isCurrent = (href) => here === href;

const headTitle = ogTitle ?? title;
const headDesc = ogDescription ?? description;
---
<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content={robots}>
<meta name="theme-color" content="#141A22">

<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="The Enterprise Edge">
<meta property="og:title" content={headTitle}>
<meta property="og:description" content={headDesc}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content={ogImageWidth}>
<meta property="og:image:height" content={ogImageHeight}>
<meta property="og:image:alt" content={ogImageAlt}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={headTitle}>
<meta name="twitter:description" content={headDesc}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogImageAlt}>

{/* Fonts are served from this origin, so no visitor IP reaches a third
     party to load them. Same reasoning as inspireyourbuyers.com: it is a
     standing question on enterprise privacy reviews, and this audience runs
     those reviews for a living. */}
<link rel="icon" href="/assets/ee-mark.svg" type="image/svg+xml">

<link rel="preconnect" href="/">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="preload" href="/fonts/ArchivoNarrow-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin>

<script type="application/ld+json" set:html={JSON.stringify(graphLd)} />

{/* Set before first paint so the reveal styles never apply when JS is off.
     If this never runs, nothing is ever hidden. */}
<script is:inline>document.documentElement.className += ' js';</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="head-sentinel" aria-hidden="true"></div>

<header class="site-head">
  <div class="head-in">
    {/* The finished lockup, mark and wordmark as one artwork. It replaced a
        hand-set version of the same thing; the accessible name moves onto the
        link because the image now carries the words and repeating them in alt
        text would announce the brand twice.

        width and height are set so the header reserves the space before the
        image arrives and nothing shifts on load. */}
    {/* The lockup is composed here rather than used as a flat image: the
        kit's symbol, then the wordmark and phrase set live in the same fonts
        the artwork was typeset in, which this site already self-hosts.

        The baked lockup could not be adjusted. Measured off the artwork, its
        phrase rendered at a 5.7px cap height in this header, and there was no
        way to grow it without growing the symbol with it. Composed, the three
        parts size independently, stay crisp at any zoom, recolour with the
        tokens, and cost one 40KB image instead of a 50KB one.

        The phrase is dropped below 700px in CSS rather than shrunk, which is
        the kit's own guidance. */}
    <a class="brand" href="/" aria-label="The Enterprise Edge, home">
      <img class="brand-symbol" src="/assets/ee-symbol.png" alt="" width="1254" height="1254" />
      <span class="brand-type">
        <span class="brand-name">The Enterprise <i>Edge</i></span>
        <span class="brand-phrase">Clarity creates advantage</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {NAV.map((n) => (
        <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      {/* Registration happens on Luma, one event per city. Until a city has a
          real event, this points at the dates section rather than at a Luma
          calendar with nothing on it.

          Keyed on HAS_REGISTRATION, not HAS_DATES. Those two came apart the
          moment a city had a confirmed date but no event page yet, and this
          button was still on the old flag: it read "Reserve a Seat" and sent
          people to a Luma calendar with nothing on it. A date existing is not
          the same as a seat being bookable. */}
      {HAS_REGISTRATION
        ? <a class="nav-cta" href={LUMA_URL} target="_blank" rel="noopener noreferrer">Reserve a Seat</a>
        : <a class="nav-cta" href="/#dates">See Dates</a>}
    </nav>
  </div>
</header>

<main id="main">
  <slot />
</main>

<footer class="site-foot">
  <div class="foot-in">
    <div class="foot-col">
      <h2>The Enterprise Edge</h2>
      <p class="foot-tagline">Clarity creates advantage.</p>
    </div>
    <div class="foot-col">
      <h2>The Program</h2>
      <ul>
        <li><a href="/#edges">The Three Edges</a></li>
        <li><a href="/#dates">Dates and Cities</a></li>
        <li><a href="/#agenda">The Half Day</a></li>
        <li><a href="/assessment/">Take the Assessment</a></li>
        <li><a href="/work-with-us/">Work With Us</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h2>Who We Are</h2>
      <ul>
        <li><a href="/value-edge/">Bruce Scheer</a></li>
        <li><a href="/approval-edge/">Dean Edwards</a></li>
        <li><a href="/expansion-edge/">Sandy Yu</a></li>
        <li><a href="/faculty/">All three of us</a></li>
      </ul>
    </div>
    <div class="foot-col">
      <h2>Attend</h2>
      <ul>
        <li><a href="/#dates">Dates and cities</a></li>
        {HAS_REGISTRATION && <li><a href={LUMA_URL} target="_blank" rel="noopener noreferrer">All events on Luma</a></li>}
      </ul>
    </div>
  </div>
  <div class="foot-legal">
    {/* Names the three and stops. It used to add "it is not a legal entity,
         and engagements are contracted with each of us individually", which
         was true but was a disclaimer in the reader's face on every page.
         Nobody asked, and the point of this site is that the three show up
         aligned. The commercial arrangement is a fact for a contract, not a
         message for a footer. Do not put it back.

         "is brought to you by" rather than "is". Bruce asked for it, and it
         does something the shorter version did not: the programme reads as
         a thing the three of them put on together, rather than as a label
         for the three of them. */}
    <p>The Enterprise Edge is brought to you by Bruce Scheer, Dean Edwards and Sandy Yu.</p>
    <p><a href="/privacy/">Privacy</a></p>
    {/* The brand, not the three names. The line directly above this one
         already names all three, and saying them twice in consecutive
         sentences read as a stutter rather than as thoroughness. */}
    <p>&copy; {new Date().getFullYear()} The Enterprise Edge. All rights reserved.</p>
  </div>
</footer>

<script is:inline>
  /* Keep the hero's next-session line honest on a site that may not have
     been rebuilt since a session passed. Same sum the build did, redone
     against the browser's clock. */
  (function () {
    var el = document.querySelector('.next-session');
    if (!el) return;
    var list;
    try { list = JSON.parse(el.dataset.sessions || '[]'); } catch (e) { return; }
    var now = Date.now();
    var next = list.filter(function (s) { return new Date(s.iso).getTime() > now; })[0];
    if (!next) { el.hidden = true; return; }
    var city = el.querySelector('.ns-city');
    var date = el.querySelector('.ns-date');
    if (city) city.textContent = next.city;
    if (date) date.textContent = next.date;
  })();

  /* Condense the header once a 120px sentinel leaves the viewport. An
     observer rather than a scroll listener, so the browser does the work off
     the main thread. */
  (function () {
    var head = document.querySelector('.site-head');
    var sentinel = document.querySelector('.head-sentinel');
    if (head && sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        head.classList.toggle('is-stuck', !entries[0].isIntersecting);
      }).observe(sentinel);
    }

    /* Reveal bands as they arrive. The .js gate is dropped after 2.5s if this
       never starts, so content can never be stranded at opacity:0. */
    var bands = document.querySelectorAll('main .band');
    if (!('IntersectionObserver' in window) || !bands.length) {
      document.documentElement.classList.remove('js');
      return;
    }
    var started = false;
    var io = new IntersectionObserver(function (entries) {
      started = true;
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      });
    }, { rootMargin: '0px 0px -10% 0px' });
    bands.forEach(function (b) { io.observe(b); });
    setTimeout(function () {
      if (!started) document.documentElement.classList.remove('js');
    }, 2500);
  })();
</script>
</body>
</html>
