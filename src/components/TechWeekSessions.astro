---
interface SessionVideo {
  id: string;
  title: string;
  src: string;
  poster: string;
  captions: string;
  transcript: string;
  width: number;
  height: number;
}

interface Props {
  videos: SessionVideo[];
  photo: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
}

// Integrate only after the intended files and accurate captions are reviewed.
// Titles and transcripts must come from that review, never guessed identities.
const { videos, photo } = Astro.props;
---

<section class="band band-bone2 tech-week-sessions" id="tech-week-sessions" aria-labelledby="tech-week-heading">
  <div class="wrap">
    <h2 id="tech-week-heading">From our sessions at Tech Week</h2>
    <div class="session-videos">
      {videos.map((video) => (
        <article class="session-video" aria-labelledby={`session-title-${video.id}`}>
          <h3 id={`session-title-${video.id}`}>{video.title}</h3>
          <video
            controls
            playsinline
            preload="none"
            poster={video.poster}
            width={video.width}
            height={video.height}
            aria-labelledby={`session-title-${video.id}`}
          >
            <source src={video.src} type="video/mp4" />
            <track kind="captions" src={video.captions} srclang="en" label="English" default />
            <p><a href={video.src}>Open this session video</a>.</p>
          </video>
          <details class="more-detail">
            <summary>Read transcript</summary>
            <div class="more-body"><p>{video.transcript}</p></div>
          </details>
        </article>
      ))}
    </div>
    <figure class="session-photo">
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .session-videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    max-width: 44rem;
    margin: 2.5rem auto;
  }
  .session-video { min-width: 0; }
  .session-video h3 { margin: 0 0 .75rem; }
  .session-video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: contain;
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .session-video .more-detail { margin-top: 1rem; }
  .session-photo { max-width: 58rem; margin: 3rem auto 0; }
  .session-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .tech-week-sessions :focus-visible {
    outline-color: var(--bronze);
  }
  @media (max-width: 600px) {
    .session-videos {
      grid-template-columns: minmax(0, 1fr);
      max-width: 22rem;
      gap: 2.5rem;
    }
  }
</style>
