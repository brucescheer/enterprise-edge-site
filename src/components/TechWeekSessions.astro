---
interface SessionVideo {
  id: string;
  title: string;
  src: string;
  poster: string;
  vimeoId?: string;
  captions?: string;
  transcript?: string;
  duration: string;
  note?: string;
  width: number;
  height: number;
}

interface Props {
  videos: SessionVideo[];
  photo: {
    src: string;
    alt: string;
    width: number;
    height: number;
    webp: string;
    webpSmall: string;
  };
}

// Use the reviewed media with neutral labels. Add captions and transcripts
// only when their wording is verified; never publish guessed identities.
const { videos, photo } = Astro.props;
---

<section class="band band-bone2 tech-week-sessions" id="tech-week-sessions" aria-labelledby="tech-week-heading">
  <div class="wrap">
    <h2 id="tech-week-heading">Attendee takeaways</h2>
    <div class="session-videos">
      {videos.map((video) => (
        <article class="session-video" aria-labelledby={`session-title-${video.id}`}>
          <div class="session-caption">
            <h3 class="sr-only" id={`session-title-${video.id}`}>{video.title}</h3>
            <span id={`session-duration-${video.id}`}>{video.duration}</span>
          </div>
          {video.vimeoId ? (
            <iframe
              src={`https://player.vimeo.com/video/${video.vimeoId}?title=0&byline=0&portrait=0&badge=0&autopause=0&player_id=0&app_id=58479&autoplay=0&playsinline=1&preload=none&dnt=1`}
              title={`${video.title}: Tech Week reflection (Vimeo)`}
              width={video.width}
              height={video.height}
              loading="lazy"
              allow="fullscreen; picture-in-picture; encrypted-media"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
              aria-describedby={`session-duration-${video.id}`}
            />
          ) : (
            <video
              controls
              playsinline
              preload="none"
              poster={video.poster}
              width={video.width}
              height={video.height}
              aria-labelledby={`session-title-${video.id}`}
              aria-describedby={`session-duration-${video.id}`}
            >
              <source src={video.src} type="video/mp4" />
              {video.captions && <track kind="captions" src={video.captions} srclang="en" label="English" default />}
              <p><a href={video.src}>Open this session video</a>.</p>
            </video>
          )}
          {video.note && <p class="session-note">{video.note}</p>}
          {video.transcript && <details class="more-detail">
            <summary>Read transcript</summary>
            <div class="more-body"><p>{video.transcript}</p></div>
          </details>}
        </article>
      ))}
    </div>
    <figure class="session-photo">
      <picture>
        <source type="image/webp" srcset={`${photo.webpSmall} 960w, ${photo.webp} 1600w`} sizes="(max-width: 968px) calc(100vw - 40px), 928px" />
        <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        decoding="async"
        />
      </picture>
    </figure>
  </div>
</section>

<style>
  .session-videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    max-width: 44rem;
    margin: 2.5rem auto;
  }
  .session-video { min-width: 0; }
  .session-video:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    width: calc((100% - 2rem) / 2);
    justify-self: center;
  }
  .session-caption { display: flex; align-items: baseline; justify-content: flex-end; margin-bottom: .75rem; }
  .session-caption span { color: var(--muted); font-size: .85rem; white-space: nowrap; }
  .session-note { margin: .75rem 0 0; font-size: .9rem; line-height: 1.5; }
  .session-video video,
  .session-video iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: contain;
    background: var(--ink);
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .session-video .more-detail { margin-top: 1rem; }
  .session-photo { max-width: 58rem; margin: 3rem auto 0; }
  .session-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .tech-week-sessions :focus-visible {
    outline-color: var(--bronze);
  }
  @media (max-width: 600px) {
    .session-videos {
      grid-template-columns: minmax(0, 1fr);
      max-width: 22rem;
      gap: 2.5rem;
    }
    .session-video:last-child:nth-child(odd) { grid-column: auto; width: 100%; }
  }
</style>
